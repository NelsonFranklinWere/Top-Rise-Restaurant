# Copy to .env.local and fill in. Never commit the real file.

# Live site address, used for SEO tags and the sitemap
NEXT_PUBLIC_BASE_URL=https://www.example.co.ke

# PostgreSQL connection for the editable menu
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/toprise
# Set to true when the database requires SSL (most hosted databases)
DATABASE_SSL=false

# Password for /admin
ADMIN_PASSWORD=choose-a-strong-password
# At least 24 random characters, used to sign the admin session cookie
SESSION_SECRET=replace-with-a-long-random-string
